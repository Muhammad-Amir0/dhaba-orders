{
    "name": "dhaba/stats-api",
    "type": "project",
    "description": "Read-only Redis statistics API for Dhaba Orders",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "11.57.1",
        "predis/predis": "2.4.1"
    },
    "require-dev": {
        "phpstan/phpstan": "2.1.56",
        "phpunit/phpunit": "11.5.58"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --configuration=phpstan.neon"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
